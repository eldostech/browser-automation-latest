# ---------------------------------------------------------------------------
# Copy to .env and fill in.  The .env file is read by the BACKEND ONLY.
# Never expose these values to the frontend or put them in URL query strings.
# ---------------------------------------------------------------------------

# Claude on Amazon Bedrock is the only provider. Credentials come from the
# standard AWS chain -- see "AWS credentials for Bedrock" below.

# --- Which model does what --------------------------------------------------
# Three roles, so the expensive one is only used where it earns its keep.
#
# On Bedrock these are cross-region inference profiles, so the ID carries a
# region prefix ("us." / "eu." / "apac." / "global.").
# Check what your account can actually call -- this probes each ID with a
# one-token request and tells a wrong ID apart from a missing entitlement:
#   python backend/scripts/check_models.py --survey
#
# A 400 "model identifier is invalid" means the ID string is wrong.
# A 403 "not available for this account" means the ID was understood but the
# account lacks that model -- request access in the Bedrock console. Note that
# the 403 names the ID with the region prefix STRIPPED, so it looks like an ID
# you never configured.

# There is one role left. The driver and the distiller went with the agent:
# a workflow is recorded by watching somebody do it, and the recording is
# parsed rather than interpreted, so neither costs a token.
#
# This model is asked one question, rarely: a step's locator stopped
# matching, here is the page now, which control did it mean? The answer is
# written back into the use case and then repeats on every future row, so
# it is worth capability rather than speed.
LLM_REPAIR_MODEL=us.anthropic.claude-sonnet-4-6

LLM_MAX_TOKENS=16384
LLM_TEMPERATURE=0.0

# --- AWS credentials for Bedrock --------------------------------------------
# Both optional, and usually best left unset: the AWS SDK then resolves them
# itself from the environment, ~/.aws (including SSO), or the IAM role attached
# to the instance, task or pod. That is what lets the same build run on a
# laptop and on EC2/ECS/Lambda with no change.
#
# Set them only to pin a region or pick a named profile explicitly. The usual
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN are read
# straight from the environment by the SDK and are not settings here -- do not
# put long-lived keys in this file if a role or SSO will do.
#
# Check what your account can actually call:
#   python backend/scripts/check_models.py --survey
# AWS_REGION=us-east-1
# AWS_PROFILE=default

# --- Credentials ------------------------------------------------------------
# Fernet key encrypting stored site credentials (the sign-in details a use
# case reuses on every run) -- unrelated to signing in to this app yourself,
# which uses hashed session tokens and needs no key here.
#
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Left unset, credential storage is DISABLED -- deliberately, rather than
# falling back to writing passwords in the clear. Keep this with your other
# secrets: losing it makes existing stored credentials unreadable.
CREDENTIALS_KEY=

# --- Replay (executing a recorded use case; no LLM involved) -----------------
# Delay between rows of a batch. Politeness toward the target site.
REPLAY_ROW_DELAY_SECONDS=0.3
# Abort a batch after this many consecutive row failures.
REPLAY_FAILURE_STREAK_LIMIT=5
# How long a step waits for the element it is looking for. This is the whole
# budget: a step returns the moment the element appears, so raising it costs
# nothing on a healthy site and only lengthens genuine failures. Raise it for a
# site that takes longer than this to render a page -- the symptom is "no
# element matched" on a step that works when you watch it happen.
REPLAY_STEP_TIMEOUT=30

# Extra values this deployment answers {{env.x}} with, as JSON.
#
# NOT the base URL: that comes from a target, which is a row you edit in the
# app rather than a variable you deploy. One map per deployment only works
# while every use case shares a base URL, and stops the moment you automate a
# second site. See Targets in the interface, and section 8.4 of the design
# document.
#
#   USECASE_ENV={"support_portal": "https://help.example.com"}
USECASE_ENV={}

# What to call this deployment in the interface: Dev, UAT, Production. Shown
# beside the product name so nobody has to guess which environment they are
# about to run a batch against. Leave blank on a single-environment install.
ENVIRONMENT=

# How much of an executed use case to photograph. Recording a use case always
# screenshots every step, and that is not configurable; this setting is the
# separate question of what to capture when the use case is *run*, which used
# to be nothing unless a step failed.
#   off        nothing at all
#   failure    only where a step failed
#   final      one per row, showing the end state -- the audit artifact
#   every_step everything; useful for troubleshooting, gigabytes over a large
#              batch, so put STORAGE_BACKEND on S3 first
# Headless makes no difference to any of this: screenshots work identically.
REPLAY_SCREENSHOTS=final

# Self-healing: the CEILING for it, not the decision any more.
#
# Whether a given workflow may spend a token is now a property of the use case
# -- its "How it runs" card, holding "strict" or "guided" -- because one site
# is rebuilt every sprint and another has not changed in four years, and one
# variable here cannot be right for both.
#
# This setting can only ever restrict. False means no use case in this
# deployment can be healed however it is marked, which is what an operator who
# switched it off meant. True means each use case decides for itself; one that
# has never chosen behaves as it did before the choice existed, which is why
# turning this on does not silently change anything.
#
# OFF by default, deliberately: healing is the best defence against a site
# redesign and also the easiest way to turn a free batch back into an expensive
# one. Only steps whose on_failure is "heal" are ever offered a repair, and the
# caps below bound a whole batch. A successful repair is written back as a new
# use case version, so it is paid for once.
REPLAY_HEALING_ENABLED=false
REPLAY_HEAL_MAX_ATTEMPTS=3
REPLAY_HEAL_MAX_TOKENS=20000

# --- Healing memory ---------------------------------------------------------
# When a locator breaks and a repair is confirmed, the fix is remembered: the
# page it broke on, what it used to look for, what it looks for now, and a
# plain-English note about what changed. The next time something breaks on the
# same site, those fixes go into the prompt as evidence.
#
# The point is cost. A site redesign breaks every workflow that touches it;
# remembering the first repair means the rest are recalled rather than worked
# out. Off, healing behaves exactly as it did before -- the memory is an
# optimisation, never a dependency, and a stale entry can make healing worse
# but never unsafe: the model still has to pick a control that is on the page.
#
# Needs the pgvector extension. Aurora PostgreSQL ships it; a local Postgres
# needs it installed on the server, and `make db-upgrade` says so if it is not.
HEALING_MEMORY_ENABLED=true

# How a page becomes a vector. "bedrock" uses Titan Text Embeddings V2 through
# the same credential chain as everything else. "hash" is a deterministic
# stand-in for a deployment with no Bedrock access: similar text still scores
# closer than unrelated text, which is all retrieval needs, but it is not a
# real embedding and recall will be poorer.
EMBEDDING_BACKEND=bedrock
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# --- Browser ----------------------------------------------------------------
# A replay drives Playwright directly. There is no MCP server in the replay
# path any more: a JSON-RPC hop to a Node process that then calls Playwright
# was a translation layer between us and the library we actually want, and it
# could not offer auto-waiting, locator strictness or traces.
BROWSER_ENGINE=chromium

# Headless by default, because a batch runs unattended. A single-row execution
# can still ask for a visible window per request -- watching it work is the
# fastest way to understand why a step fails.
BROWSER_HEADLESS=true

# Write a Playwright trace per execution and keep it as an artifact. It opens
# in Playwright's own viewer with a DOM snapshot per action, which for a batch
# that failed on row 412 is the difference between having a screenshot and
# being able to look around the page. Off by default: a few MB per run.
BROWSER_TRACE=false

# --- Recorder ---------------------------------------------------------------
# A workflow is recorded by watching someone do it once: `npx playwright
# codegen` opens a real browser window, the user performs the task, and closing
# the window leaves a script behind that the backend parses into steps. No
# model is involved, and no tokens are spent.
#
# That window needs a display, so recording is a local capability. A deployment
# without one sets RECORDER_ENABLED=false and answers 501 on the recording
# endpoints, rather than failing at spawn time with an X11 error nobody can
# act on. EKS runs replay workers; it does not record.
RECORDER_ENABLED=true

# How codegen is invoked. Left blank it runs the Playwright installed with the
# backend, which is what keeps the recorder and the replay engine on the same
# version -- codegen's output is the input the parser reads, and that output is
# not a stable contract across releases. No Node is required.
RECORDER_COMMAND=
RECORDER_BROWSER=chromium

# How long a recording window may stay open before it is closed for you.
# Generous on purpose: a person working through a real form is slow, and losing
# their recording to a timeout costs far more than a stray browser process.
RECORDER_TIMEOUT_SECONDS=1800

# --- Agent ------------------------------------------------------------------
# The third deployment role, beside the recorder and the worker. It exists for
# the same reason they do: capabilities differ per machine, and a laptop, a
# replay pod and a managed runtime are not the same machine.
#
# Off by default because it needs an optional dependency group and a Node
# runtime:
#   pip install -r backend/requirements-agent.txt
#   node --version   # 18 or newer, for `npx @playwright/mcp`
# With those absent the platform behaves exactly as it did before the agent
# existed, and the API answers 501 on the agent endpoints rather than failing
# at spawn time with a message about a missing executable.
#
# Nothing about recording with `playwright codegen` changes. That is a separate
# role, it still needs a display, and it is still the free way to record.
AGENT_ENABLED=false

# Where the agent's browser comes from.
#   local  `npx @playwright/mcp`, owning its own Chromium.
#   cdp    attach to a browser somebody else runs, at AGENT_CDP_ENDPOINT.
#          This is the managed-browser path -- an AgentCore Browser session --
#          and it is the whole reason the provider is an interface.
AGENT_BROWSER_PROVIDER=local
AGENT_CDP_ENDPOINT=

# Pinned for the reason `playwright` is pinned in requirements.txt: this
# server's tool names and argument shapes are the contract the tool registry is
# written against, and `@latest` would let a release change them inside
# somebody's session rather than in CI.
AGENT_MCP_VERSION=0.0.80

# Headless by default. Watching an authoring session is a per-session choice
# made where the session starts, not a property of the deployment.
AGENT_HEADLESS=true

# --- Job worker -------------------------------------------------------------
# Batches run on a durable Postgres queue rather than an asyncio task owned by
# whichever process accepted the upload, so a restart does not lose them and a
# second machine can help.
#
# WORKER_ENABLED true means this process claims queued batches as well as
# serving HTTP -- which is what makes a single-machine install work with
# nothing else started. Set it false on an API pod that should only serve
# requests, and run `make worker` (or a worker Deployment) beside it.
WORKER_ENABLED=true

# How long the worker waits before asking for work again when the queue is
# empty. Polling rather than LISTEN/NOTIFY: a notification can be missed while
# the worker is busy, so a correct implementation has to poll as a backstop
# anyway, and once it polls the notification only saves latency nobody can
# perceive.
WORKER_POLL_SECONDS=2.0

# Batches running at once *per workspace*. One reproduces the old single-slot
# behaviour, except that it is now a limit each tenant gets on its own rather
# than one global lock, so a thousand-row batch in one workspace cannot stop
# another workspace running anything at all.
WORKER_WORKSPACE_CONCURRENCY=1

# --- Database ---------------------------------------------------------------
# Postgres. Supplied in parts rather than as one DSN, because a password
# containing '@', ':' or '/' cannot be safely interpolated into a URL --
# db/engine.py escapes each part itself.
#
# Create the schema and apply migrations with:
#     make db-upgrade
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=***********
DB_SCHEMA=automation_v2
# (pool_size + max_overflow) * worker processes must stay under the server's
# max_connections.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
# Seconds a request waits for a free connection before giving up.
DB_POOL_TIMEOUT=30
# Log every statement. Useful when a query surprises you, unusable otherwise --
# it prints the parameters too, so leave it off anywhere near real data.
DB_ECHO=false

# --- Authentication ---------------------------------------------------------
# Sessions are opaque bearer tokens, hashed at rest -- there is no signing
# secret to configure. There is no SSO/OIDC yet; accounts are local.
AUTH_SESSION_TTL_HOURS=12
AUTH_BCRYPT_ROUNDS=12
# The first administrator, created only if the database holds no users at
# all -- so a fresh install is reachable. Leave the password blank and a
# strong one is generated and printed ONCE to the log at first boot.
BOOTSTRAP_ADMIN_EMAIL=admin@localhost
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_WORKSPACE_NAME=Default

# --- Artifact storage -------------------------------------------------------
# Where screenshots go. "local" writes under ARTIFACTS_DIR; "s3" uploads to a
# bucket and serves short-lived presigned URLs so the bytes never pass through
# the backend. Rows written under one backend stay readable after switching.
STORAGE_BACKEND=local
# S3_BUCKET is required when STORAGE_BACKEND=s3, and startup fails without it
# rather than failing on the first screenshot.
S3_BUCKET=
S3_PREFIX=artifacts
# Blank falls back to AWS_REGION.
S3_REGION=
# Set for MinIO or another S3-compatible store; blank means real AWS.
S3_ENDPOINT_URL=
# How long a presigned artifact URL lives. Short: it is a bearer URL for
# content that is otherwise access-controlled.
S3_URL_EXPIRY_SECONDS=900

# --- Logging ----------------------------------------------------------------
# Logs always go to stdout. This adds a rotating file, which is what you want
# when running the backend directly (stdout scrolls away) and usually not in a
# container (the platform collects stdout already).
LOG_TO_FILE=true
LOG_DIR=./logs
LOG_FILE_NAME=backend.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ARTIFACTS_DIR=./artifacts
LOG_LEVEL=INFO
# Comma separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---------------------------------------------------------------
# Read by Vite from THIS file (vite.config.ts points envDir here, or Vite would
# only look in frontend/). Baked in at build time, so a change needs a rebuild
# or a dev-server restart -- it is not read at runtime.
#
# LEAVE IT BLANK unless you have to. Blank means the frontend calls its own
# origin and something in front proxies /api to the backend: Vite in dev,
# nginx in the container. That is same-origin, so CORS never comes into it, and
# the dev proxy already follows PORT above -- move the backend and it follows.
#
# Set it only for a split deployment, where the frontend is served from a
# different origin than the backend. Then the browser calls the backend
# directly, and CORS_ORIGINS must list the frontend's origin or every request
# fails.
VITE_API_BASE=http://localhost:8000

# Optional: override the Vite dev server's own port (default 5173).
# FRONTEND_PORT=5173
# Optional: point the dev proxy somewhere other than localhost:$PORT.
# BACKEND_ORIGIN=http://localhost:8000