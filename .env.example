# ---------------------------------------------------------------------------
# Copy to .env and fill in.  The .env file is read by the BACKEND ONLY.
# Never expose these values to the frontend or put them in URL query strings.
# ---------------------------------------------------------------------------

# --- LLM provider -----------------------------------------------------------
# "bedrock"   -> Claude on Amazon Bedrock, authenticated with AWS credentials.
#                No API key needed.  This is the default.
# "anthropic" -> the first-party Anthropic API, authenticated with an API key.
LLM_PROVIDER=bedrock

# --- Which model does what --------------------------------------------------
# Three roles, so the expensive one is only used where it earns its keep.
#
# The correct ID form depends on BEDROCK_API:
#   invoke -> cross-region inference profile, region-prefixed
#             ("us." / "eu." / "apac." / "global.")
#   mantle -> the short form, "anthropic.claude-sonnet-5"
# List what your account actually has enabled:
#   aws bedrock list-inference-profiles --region us-east-1
# On LLM_PROVIDER=anthropic, use the plain aliases: claude-sonnet-5, claude-opus-5.

# DRIVER -- the agent loop that records a use case by driving the browser.
# Every step of a recording costs tokens here, so keep it fast.
LLM_MODEL=us.anthropic.claude-sonnet-5

# REPAIR -- self-healing mid-run, and mending a failed use case afterwards.
# Rare, one-shot judgement calls on a page the model has never seen, whose
# answers get written back into a use case and then repeat on every future
# row. Worth more capability than the driver.
LLM_REPAIR_MODEL=us.anthropic.claude-opus-5

# DISTILLER -- the single call that turns a recording into a use case.
# Blank means "same as the driver". One call per use case rather than per
# step, so pointing it at the repair model costs little.
# LLM_DISTILL_MODEL=us.anthropic.claude-opus-5

LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0

# --- Amazon Bedrock ---------------------------------------------------------
# Which Bedrock endpoint to call:
#   invoke -> bedrock-runtime.{region}.amazonaws.com, version-suffixed model
#             IDs and inference profiles (above).  Default.
#   mantle -> the newer Messages-API Bedrock endpoint, whose model IDs are the
#             short form, e.g. LLM_MODEL=anthropic.claude-haiku-4-5
BEDROCK_API=invoke

# Both optional.  Left unset, the AWS SDK resolves credentials and region on
# its own, in this order:
#   1. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN
#   2. ~/.aws/credentials and ~/.aws/config (including SSO)
#   3. The IAM role attached to the EC2 instance / ECS task / EKS pod / Lambda
# That is what lets the same build run locally and under a role unchanged.
# AWS_REGION=us-east-1
# AWS_PROFILE=default

# NOTE ON AWS_BEARER_TOKEN_BEDROCK
# If that variable is set in the environment, the Anthropic SDK authenticates
# with it (a Bedrock API key) INSTEAD of SigV4 -- and hard-fails if AWS_PROFILE
# is also set:
#     ValueError: Cannot specify both `api_key` and AWS credentials
# To force IAM-role / local-credential auth, unset it:
#     unset AWS_BEARER_TOKEN_BEDROCK          # bash
#     Remove-Item Env:AWS_BEARER_TOKEN_BEDROCK  # PowerShell
# GET /healthz reports which method is actually in use.

# --- Anthropic API (only when LLM_PROVIDER=anthropic) -----------------------
# ANTHROPIC_API_KEY=sk-ant-...

# --- Playwright MCP server --------------------------------------------------
# Transport: "stdio" (backend spawns the server) or "http" (connect to a
# server you started yourself, e.g. `npx @playwright/mcp@latest --port 8931`).
MCP_TRANSPORT=stdio

# stdio-mode settings
MCP_NPX_PACKAGE=@playwright/mcp@latest
MCP_BROWSER=chromium
MCP_HEADLESS=true
MCP_ISOLATED=true
# Optional path to a saved storage state (cookies/localStorage) JSON file.
# MCP_STORAGE_STATE=./data/storage-state.json
# Extra raw flags passed through to the MCP server, space separated.
# MCP_EXTRA_ARGS=--viewport-size=1280,800

# http-mode settings (ignored when MCP_TRANSPORT=stdio)
# Use the /sse suffix for the SSE endpoint; anything else is treated as
# Streamable HTTP.
MCP_SERVER_URL=http://localhost:8931/sse

# Seconds to wait for the MCP initialize handshake before giving up.
MCP_HANDSHAKE_TIMEOUT=45
# Seconds any single browser tool call may take.
MCP_TOOL_TIMEOUT=60

# --- Agent guardrails (defaults; per-run values may override) ---------------
AGENT_MAX_STEPS=30
AGENT_TIMEOUT_SECONDS=300
# Comma separated. Supports wildcards: *.example.com
# "*" disables the allowlist entirely -- NOT recommended, see README.
AGENT_ALLOWED_DOMAINS=example.com,*.example.com
AGENT_REQUIRE_APPROVAL=true
AGENT_APPROVAL_TIMEOUT_SECONDS=300
# Take a screenshot after each step for the dashboard (does not go to the LLM).
AGENT_SCREENSHOT_EVERY_STEP=true

# --- Credentials ------------------------------------------------------------
# Fernet key encrypting stored credentials. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Left unset, credential storage is DISABLED -- deliberately, rather than
# falling back to writing passwords in the clear. Keep this with your other
# secrets: losing it makes existing stored credentials unreadable.
# CREDENTIALS_KEY=

# --- Replay (executing a recorded use case; no LLM involved) -----------------
# Delay between rows of a batch. Politeness toward the target site.
REPLAY_ROW_DELAY_SECONDS=0.3
# Abort a batch after this many consecutive row failures.
REPLAY_FAILURE_STREAK_LIMIT=5
REPLAY_STEP_TIMEOUT=30

# Self-healing. OFF by default, deliberately: it is the best defence against a
# site redesign and also the easiest way to turn a free batch back into an
# expensive one. Only steps whose on_failure is "heal" are ever offered a
# repair, and the caps below bound a whole batch. A successful repair is
# written back as a new use case version, so it is paid for once.
REPLAY_HEALING_ENABLED=false
REPLAY_HEAL_MAX_ATTEMPTS=3
REPLAY_HEAL_MAX_TOKENS=20000

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=./data/runs.db
ARTIFACTS_DIR=./artifacts
LOG_LEVEL=INFO
# Comma separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---------------------------------------------------------------
# Read by Vite at build time. Contains no secrets -- just where the backend is.
VITE_API_BASE=http://localhost:8000
