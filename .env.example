# ---------------------------------------------------------------------------
# Copy to .env and fill in.  The .env file is read by the BACKEND ONLY.
# Never expose these values to the frontend or put them in URL query strings.
# ---------------------------------------------------------------------------

# Claude on Amazon Bedrock is the only provider. Credentials come from the
# standard AWS chain -- see "AWS credentials for Bedrock" below.

# --- Which model does what --------------------------------------------------
# Three roles, so the expensive one is only used where it earns its keep.
#
# On Bedrock these are cross-region inference profiles, so the ID carries a
# region prefix ("us." / "eu." / "apac." / "global.").
# Check what your account can actually call -- this probes each ID with a
# one-token request and tells a wrong ID apart from a missing entitlement:
#   python backend/scripts/check_models.py --survey
#
# A 400 "model identifier is invalid" means the ID string is wrong.
# A 403 "not available for this account" means the ID was understood but the
# account lacks that model -- request access in the Bedrock console. Note that
# the 403 names the ID with the region prefix STRIPPED, so it looks like an ID
# you never configured.

# DRIVER -- the agent loop that records a use case by driving the browser.
# Every step of a recording costs tokens here, so keep it fast.
LLM_MODEL=us.anthropic.claude-sonnet-5

# REPAIR -- self-healing mid-run, and mending a failed use case afterwards.
# Rare, one-shot judgement calls on a page the model has never seen, whose
# answers get written back into a use case and then repeat on every future
# row. Worth more capability than the driver.
LLM_REPAIR_MODEL=us.anthropic.claude-opus-5

# DISTILLER -- the single call that turns a recording into a use case.
# Blank means "same as the driver". One call per use case rather than per
# step, so pointing it at the repair model costs little.
# LLM_DISTILL_MODEL=us.anthropic.claude-opus-5

LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0

# --- AWS credentials for Bedrock --------------------------------------------
# Both optional, and usually best left unset: the AWS SDK then resolves them
# itself from the environment, ~/.aws (including SSO), or the IAM role attached
# to the instance, task or pod. That is what lets the same build run on a
# laptop and on EC2/ECS/Lambda with no change.
#
# Set them only to pin a region or pick a named profile explicitly. The usual
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN are read
# straight from the environment by the SDK and are not settings here -- do not
# put long-lived keys in this file if a role or SSO will do.
#
# Check what your account can actually call:
#   python backend/scripts/check_models.py --survey
# AWS_REGION=us-east-1
# AWS_PROFILE=default


# --- Playwright MCP server --------------------------------------------------
# Transport: "stdio" (backend spawns the server) or "http" (connect to a
# server you started yourself, e.g. `npx @playwright/mcp@latest --port 8931`).
MCP_TRANSPORT=stdio

# stdio-mode settings
MCP_NPX_PACKAGE=@playwright/mcp@latest
MCP_BROWSER=chromium
MCP_HEADLESS=true
MCP_ISOLATED=true
# Optional path to a saved storage state (cookies/localStorage) JSON file.
# MCP_STORAGE_STATE=./data/storage-state.json
# Extra raw flags passed through to the MCP server, space separated.
# MCP_EXTRA_ARGS=--viewport-size=1280,800

# http-mode settings (ignored when MCP_TRANSPORT=stdio)
# Use the /sse suffix for the SSE endpoint; anything else is treated as
# Streamable HTTP.
MCP_SERVER_URL=http://localhost:8931/sse

# Seconds to wait for the MCP initialize handshake before giving up.
MCP_HANDSHAKE_TIMEOUT=45
# Seconds any single browser tool call may take.
MCP_TOOL_TIMEOUT=60

# --- Agent guardrails (defaults; per-run values may override) ---------------
AGENT_MAX_STEPS=30
AGENT_TIMEOUT_SECONDS=300
# Comma separated. Supports wildcards: *.example.com
# "*" disables the allowlist entirely -- NOT recommended, see README.
AGENT_ALLOWED_DOMAINS=example.com,*.example.com
AGENT_REQUIRE_APPROVAL=true
AGENT_APPROVAL_TIMEOUT_SECONDS=300
# Take a screenshot after each step for the dashboard (does not go to the LLM).
AGENT_SCREENSHOT_EVERY_STEP=true
# Tool results are fed back to the model verbatim, so one enormous accessibility
# snapshot could otherwise fill the context window on its own.
AGENT_MAX_TOOL_RESULT_CHARS=20000
# Oldest tool results are trimmed once the history passes this many messages.
AGENT_MAX_HISTORY_MESSAGES=60

# --- Credentials ------------------------------------------------------------
# Fernet key encrypting stored credentials. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Left unset, credential storage is DISABLED -- deliberately, rather than
# falling back to writing passwords in the clear. Keep this with your other
# secrets: losing it makes existing stored credentials unreadable.
# CREDENTIALS_KEY=

# --- Replay (executing a recorded use case; no LLM involved) -----------------
# Delay between rows of a batch. Politeness toward the target site.
REPLAY_ROW_DELAY_SECONDS=0.3
# Abort a batch after this many consecutive row failures.
REPLAY_FAILURE_STREAK_LIMIT=5
REPLAY_STEP_TIMEOUT=30

# How much of an executed use case to photograph. Recording a use case always
# screenshots every step (AGENT_SCREENSHOT_EVERY_STEP); this is the separate
# question of what to capture when the use case is *run*, which used to be
# nothing unless a step failed.
#   off        nothing at all
#   failure    only where a step failed
#   final      one per row, showing the end state -- the audit artifact
#   every_step everything; useful for troubleshooting, gigabytes over a large
#              batch, so put STORAGE_BACKEND on S3 first
# Headless makes no difference to any of this: screenshots work identically.
REPLAY_SCREENSHOTS=final

# Self-healing. OFF by default, deliberately: it is the best defence against a
# site redesign and also the easiest way to turn a free batch back into an
# expensive one. Only steps whose on_failure is "heal" are ever offered a
# repair, and the caps below bound a whole batch. A successful repair is
# written back as a new use case version, so it is paid for once.
REPLAY_HEALING_ENABLED=false
REPLAY_HEAL_MAX_ATTEMPTS=3
REPLAY_HEAL_MAX_TOKENS=20000

# --- Database ---------------------------------------------------------------
# Postgres. Supplied in parts rather than as one DSN, because a password
# containing '@', ':' or '/' cannot be safely interpolated into a URL --
# db/engine.py escapes each part itself.
#
# Create the schema and apply migrations with:
#     make db-upgrade
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
# A named schema, so this app can share a database without colliding.
DB_SCHEMA=browser
# (pool_size + max_overflow) * worker processes must stay under the server's
# max_connections.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
# Seconds a request waits for a free connection before giving up.
DB_POOL_TIMEOUT=30
# Log every statement. Useful when a query surprises you, unusable otherwise --
# it prints the parameters too, so leave it off anywhere near real data.
DB_ECHO=false

# LangGraph's checkpointer: what lets a recording that was interrupted resume
# instead of being marked failed. Postgres is used where the driver can run;
# on Windows it falls back to this SQLite file, because psycopg's async mode
# needs a different event loop than the browser subprocess does. See
# backend/checkpoints.py.
CHECKPOINT_ENABLED=true
CHECKPOINT_PATH=./data/checkpoints.sqlite

# --- Authentication ---------------------------------------------------------
# Sessions are opaque bearer tokens, hashed at rest -- there is no signing
# secret to configure. There is no SSO/OIDC yet; accounts are local.
AUTH_SESSION_TTL_HOURS=12
AUTH_BCRYPT_ROUNDS=12
# Created on first startup only if the database holds no users at all. Leave
# the password blank and a strong one is generated and printed ONCE to the log.
BOOTSTRAP_ADMIN_EMAIL=admin@localhost
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_WORKSPACE_NAME=Default

# --- Artifact storage -------------------------------------------------------
# Where screenshots go. "local" writes under ARTIFACTS_DIR; "s3" uploads to a
# bucket and serves short-lived presigned URLs so the bytes never pass through
# the backend. Rows written under one backend stay readable after switching.
STORAGE_BACKEND=local
# S3_BUCKET is required when STORAGE_BACKEND=s3, and startup fails without it
# rather than failing on the first screenshot.
S3_BUCKET=
S3_PREFIX=artifacts
# Blank falls back to AWS_REGION.
S3_REGION=
# Set for MinIO or another S3-compatible store; blank means real AWS.
S3_ENDPOINT_URL=
# How long a presigned artifact URL lives. Short: it is a bearer URL for
# content that is otherwise access-controlled.
S3_URL_EXPIRY_SECONDS=900

# --- Logging ----------------------------------------------------------------
# Logs always go to stdout. This adds a rotating file, which is what you want
# when running the backend directly (stdout scrolls away) and usually not in a
# container (the platform collects stdout already).
LOG_TO_FILE=true
LOG_DIR=./logs
LOG_FILE_NAME=backend.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ARTIFACTS_DIR=./artifacts
LOG_LEVEL=INFO
# Comma separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---------------------------------------------------------------
# Read by Vite at build time. Contains no secrets -- just where the backend is.
VITE_API_BASE=http://localhost:8000
