<?xml version="1.0" encoding="UTF-8"?>
<!--
  System architecture, as two draw.io pages: a simplified view for
  leadership and a detailed view for engineering. Generated from the
  actual backend/frontend code paths in this repository; protocol labels
  and the deterministic/agent split reflect what the code does, not an
  aspirational design. See README.md's "Architecture" section and
  docs/design/agent-and-deterministic.md for the prose version.

  Open with app.diagrams.net (draw.io): File > Open From > Device, or
  drag this file onto the app. Both pages are editable; source/target
  edges are attached to their nodes, so moving a box keeps its arrows.
-->
<mxfile host="app.diagrams.net" agent="trace-docs" version="24.7.5" type="device">
  <diagram name="Leadership View" id="leadership-view">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= nodes ================= -->
        <mxCell id="L-you" value="&lt;b&gt;You&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5B6270&quot;&gt;the operator&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#171A21;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="190" height="86" as="geometry" />
        </mxCell>

        <mxCell id="L-web" value="&lt;b&gt;Web Dashboard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5B6270&quot;&gt;record &amp;middot; review &amp;middot; run&lt;br&gt;watch results live&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#171A21;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="300" y="30" width="240" height="106" as="geometry" />
        </mxCell>

        <mxCell id="L-service" value="&lt;b&gt;TRACE Service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5B6270&quot;&gt;the engine that runs every workflow&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5B6270;font-style:italic&quot;&gt;a person approves every workflow before it runs at scale&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EEF0F4;strokeColor=#171A21;strokeWidth=2;fontFamily=Helvetica;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="642" y="14" width="270" height="138" as="geometry" />
        </mxCell>

        <mxCell id="L-db" value="&lt;b&gt;Your Database&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5B6270&quot;&gt;every workflow, every run, every result &amp;mdash; kept safely, on infrastructure you own&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E3F5EE;strokeColor=#047A55;strokeWidth=1.8;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="302" width="300" height="130" as="geometry" />
        </mxCell>

        <mxCell id="L-ai" value="&lt;b&gt;AI Assistant&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5B6270&quot;&gt;Claude, via AWS Bedrock&lt;br&gt;helps set a workflow up, or fixes one when a site changes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FAF0E0;strokeColor=#B45309;strokeWidth=1.8;dashed=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="627" y="302" width="300" height="130" as="geometry" />
        </mxCell>

        <mxCell id="L-site" value="&lt;b&gt;Target Website&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5B6270&quot;&gt;does the actual clicking, typing and reading &amp;mdash; thousands of times over&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E6ECFB;strokeColor=#2451C9;strokeWidth=1.8;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="924" y="302" width="300" height="130" as="geometry" />
        </mxCell>

        <mxCell id="L-why" value="&lt;b&gt;Why this shape matters&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5B6270&quot;&gt;1. Set up once &amp;mdash; with or without AI help, your choice.&lt;br&gt;2. A person reviews and approves it before it ever runs at scale.&lt;br&gt;3. Every run after that is mechanical &amp;mdash; same steps, zero AI spend, predictable cost.&lt;br&gt;4. The AI only comes back if the target site changes and a step breaks.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#171A21;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="300" y="470" width="680" height="150" as="geometry" />
        </mxCell>

        <!-- ================= edges ================= -->
        <mxCell id="Le-you-web" value="records / reviews / watches" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#5B6270;strokeColor=#171A21;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="L-you" target="L-web">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="Le-web-service" value="secure connection (dashboard &amp;#8644; service)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#5B6270;strokeColor=#171A21;strokeWidth=1.5;startArrow=block;startFill=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="L-web" target="L-service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="Le-service-db" value="always" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#047A55;strokeColor=#047A55;strokeWidth=1.8;endArrow=block;endFill=1;exitX=0.35;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="L-service" target="L-db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="Le-service-ai" value="sometimes &amp;mdash; never for the repeat work" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#B45309;strokeColor=#B45309;strokeWidth=1.8;dashed=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="L-service" target="L-ai">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="Le-service-site" value="every run &amp;mdash; no extra AI cost" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#2451C9;strokeColor=#2451C9;strokeWidth=1.8;endArrow=block;endFill=1;exitX=0.65;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="L-service" target="L-site">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="Technical View" id="technical-view">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= top: user + web app ================= -->
        <mxCell id="T-user" value="&lt;b&gt;User's browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;color:#5B6270&quot;&gt;operator &amp;mdash; chrome/edge/etc.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A21;strokeWidth=1.4;fontFamily=Helvetica;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
