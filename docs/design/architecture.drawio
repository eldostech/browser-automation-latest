        <mxCell id="T-titan" value="&lt;b&gt;Titan Embeddings&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5B6270&quot;&gt;healing memory recall (pgvector)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A21;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11.5;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1372" y="502" width="286" height="66" as="geometry" />
        </mxCell>

        <mxCell id="T-callsites" value="&lt;b&gt;three call sites, by policy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5B6270&quot;&gt;&amp;bull; mapping &amp;mdash; fallback only, when heuristics can't tell&lt;br&gt;&amp;bull; healing &amp;mdash; one budgeted call, off by default&lt;br&gt;&amp;bull; agent authoring &amp;mdash; every turn, system prompt + tools cached&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;color:#5B6270;font-style:italic&quot;&gt;replay itself never calls this box &amp;mdash; engine.py has no parameter that could&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#171A21;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1372" y="584" width="286" height="196" as="geometry" />
        </mxCell>

